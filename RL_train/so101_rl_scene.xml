<mujoco model="SO101-RL">
  <!--
    Self-contained RL scene for SO-101 arm.
    Uses capsule/box geoms — no mesh STL files needed.
    Kinematic chain (body positions, joint axes, ranges) matches
    so101_new_calib.xml exactly.
  -->

  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" tolerance="1e-10"/>

  <size nconmax="500" njmax="2000"/>

  <default>
    <joint damping="4.0" frictionloss="0.2" armature="0.028"/>
    <position kp="998.22" kv="8.0" forcerange="-2.94 2.94"/>
    <geom contype="1" conaffinity="1"/>
  </default>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="arm"    rgba="1.0 0.82 0.12 1"/>
    <material name="servo"  rgba="0.1 0.1 0.1 1"/>
    <material name="object" rgba="0.2 0.8 0.3 1"/>
    <material name="goal"   rgba="1.0 0.35 0.1 0.4"/>
    <material name="pad"    rgba="0.3 0.3 0.3 0.95"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- ── Robot base ──────────────────────────────────────────────── -->
    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="box" size="0.045 0.04 0.035"
            pos="0.015 0 0.018" material="arm" contype="0" conaffinity="0"/>

      <!-- shoulder: matches pos=0.0388353 0 0.0624 quat=-1 around Z -->
      <body name="shoulder" pos="0.0388353 0 0.0624"
            quat="3.56167e-16 1.22818e-15 -1 -4.14635e-16">
        <joint name="shoulder_pan" type="hinge" axis="0 0 1"
               range="-1.91986 1.91986" damping="4.0" frictionloss="0.2" armature="0.028"/>
        <geom name="shoulder_geom" type="capsule" size="0.022 0.025"
              pos="0 0 0" material="servo" contype="0" conaffinity="0"/>

        <!-- upper_arm: matches pos=-0.030 -0.018 -0.054 quat=0.5 -0.5 -0.5 -0.5 -->
        <body name="upper_arm" pos="-0.0303992 -0.0182778 -0.0542"
              quat="0.5 -0.5 -0.5 -0.5">
          <joint name="shoulder_lift" type="hinge" axis="0 0 1"
                 range="-1.74533 1.74533" damping="4.0" frictionloss="0.2" armature="0.028"/>
          <geom name="upper_arm_geom" type="capsule" size="0.018 0.045"
                pos="-0.05 0 0" quat="0.707107 0 0.707107 0"
                material="arm" contype="0" conaffinity="0"/>

          <!-- lower_arm: matches pos=-0.11257 -0.028 0 quat=0.707107 0 0 0.707107 -->
          <body name="lower_arm" pos="-0.11257 -0.028 0"
                quat="0.707107 0 0 0.707107">
            <joint name="elbow_flex" type="hinge" axis="0 0 1"
                   range="-1.69 1.69" damping="4.0" frictionloss="0.2" armature="0.028"/>
            <geom name="lower_arm_geom" type="capsule" size="0.016 0.055"
                  pos="-0.06 0 0" quat="0.707107 0 0.707107 0"
                  material="arm" contype="0" conaffinity="0"/>

            <!-- wrist: matches pos=-0.1349 0.0052 0 quat=0.707107 0 0 -0.707107 -->
            <body name="wrist" pos="-0.1349 0.0052 0"
                  quat="0.707107 0 0 -0.707107">
              <joint name="wrist_flex" type="hinge" axis="0 0 1"
                     range="-1.65806 1.65806" damping="4.0" frictionloss="0.2" armature="0.028"/>
              <geom name="wrist_geom" type="capsule" size="0.014 0.025"
                    pos="0 -0.03 0.018" material="servo" contype="0" conaffinity="0"/>

              <!-- gripper body: matches pos=0 -0.0611 0.0181 quat=0.017 -0.017 0.707 0.707 -->
              <body name="gripper" pos="0 -0.0611 0.0181"
                    quat="0.0172091 -0.0172091 0.706897 0.706897">
                <joint name="wrist_roll" type="hinge" axis="0 0 1"
                       range="-2.74385 2.84121" damping="4.0" frictionloss="0.2" armature="0.028"/>
                <geom name="gripper_body" type="box" size="0.018 0.014 0.015"
                      pos="0 0 -0.015" material="servo" contype="0" conaffinity="0"/>

                <!-- gripperframe site — exact from XML -->
                <site name="gripperframe" pos="-0.0079 -0.000218121 -0.0981274"
                      quat="0.707107 0 0.707107 0" group="3"/>

                <!-- Fixed jaw (lower jaw) -->
                <geom name="fixed_jaw" type="box" size="0.005 0.008 0.035"
                      pos="0.010 0 -0.072" material="arm"
                      contype="1" conaffinity="1"/>
                <geom name="fixed_jaw_pad" type="box" size="0.002 0.008 0.029"
                      pos="0.009 0.000 -0.069"
                      rgba="0.3 0.3 0.3 0.95"
                      friction="1.8 0.01 0.0001"
                      solref="0.015 1.0" solimp="0.92 0.98 0.001"
                      condim="4" priority="1"
                      contype="1" conaffinity="1"/>

                <!-- Moving jaw body -->
                <body name="moving_jaw" pos="0.0202 0.0188 -0.0234"
                      quat="0.707107 0.707107 0 0">
                  <joint name="gripper" type="hinge" axis="0 0 1"
                         range="-0.17453 1.74533" damping="4.0" frictionloss="0.2" armature="0.028"/>
                  <geom name="moving_jaw_link" type="box" size="0.005 0.006 0.030"
                        pos="-0.004 -0.045 0.019" material="arm"
                        contype="1" conaffinity="1"/>
                  <geom name="moving_jaw_pad" type="box" size="0.002 0.025 0.007"
                        pos="-0.009 -0.030 0.019"
                        rgba="0.3 0.3 0.3 0.95"
                        friction="1.8 0.01 0.0001"
                        solref="0.015 1.0" solimp="0.92 0.98 0.001"
                        condim="4" priority="1"
                        contype="1" conaffinity="1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ── Pickable object ──────────────────────────────────────────── -->
    <body name="pick_object" pos="0.25 0.0 0.02">
      <freejoint/>
      <geom name="obj_geom" type="cylinder" size="0.015 0.02"
            material="object" mass="0.05" friction="1.2 0.005 0.0001"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ── Goal zone visual (non-colliding) ────────────────────────── -->
    <body name="goal_visual" pos="0.18 0.0 0.001">
      <geom name="goal_geom" type="cylinder" size="0.03 0.001"
            material="goal" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_pan"  joint="shoulder_pan"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-1.91986 1.91986"/>
    <position name="shoulder_lift" joint="shoulder_lift"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-1.74533 1.74533"/>
    <position name="elbow_flex"    joint="elbow_flex"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-1.69 1.69"/>
    <position name="wrist_flex"    joint="wrist_flex"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-1.65806 1.65806"/>
    <position name="wrist_roll"    joint="wrist_roll"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-2.74385 2.84121"/>
    <position name="gripper"       joint="gripper"
              kp="998.22" kv="8.0" forcerange="-3.35 3.35" ctrlrange="-0.17453 1.74533"/>
  </actuator>

</mujoco>
