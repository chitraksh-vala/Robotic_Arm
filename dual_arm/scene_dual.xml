<mujoco model="SO-ARM101 Dual Scene">
  <!--
    Dual SO-ARM101 scene: two arms side by side, facing the same direction (+X).
    Left arm base at  y = +0.25 m
    Right arm base at y = -0.25 m
    Shared workspace centre: x≈0.22, y=0, z=0 (on the table surface)

    All joint/actuator/site names are prefixed with "L_" or "R_" to avoid conflicts.
    The shared table sits between the two arm bases.
    Three coloured blocks start in a line in the shared workspace:
      red   at (0.22,  0.06, table_top)
      green at (0.22,  0.00, table_top)
      blue  at (0.22, -0.06, table_top)
    Stack target zone: (0.30, 0.00, table_top)
  -->

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <!-- ── Defaults ─────────────────────────────────────────────────────── -->
  <default>
    <default class="so101">
      <joint damping="4.0" frictionloss="0.2" armature="0.028"/>
      <position kp="998.22" kv="8.0" forcerange="-2.94 2.94"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
      <default class="collision_L">
        <geom group="3" contype="2" conaffinity="7" rgba="0.3 0.6 0.9 0.2"/>
      </default>
      <default class="collision_R">
        <geom group="3" contype="4" conaffinity="7" rgba="0.9 0.6 0.3 0.2"/>
      </default>
      <default class="gripper_L">
        <geom group="3" contype="8" conaffinity="1" rgba="0.3 0.9 0.6 0.2"/>
      </default>
      <default class="gripper_R">
        <geom group="3" contype="16" conaffinity="1" rgba="0.9 0.9 0.3 0.2"/>
      </default>
    </default>
    <default class="block">
      <geom type="box" size="0.02 0.02 0.025" friction="2.0 0.05 0.005" condim="4" contype="1" conaffinity="31"/>
    </default>
  </default>

  <!-- ── Visual ───────────────────────────────────────────────────────── -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="180" elevation="-22" offwidth="1280" offheight="720"/>
  </visual>

  <!-- ── Assets ───────────────────────────────────────────────────────── -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <texture type="2d" name="tabletop" builtin="flat" rgb1="0.55 0.40 0.28" width="64" height="64"/>
    <material name="groundplane"  texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tabletop_mat" texture="tabletop" reflectance="0.1"/>
    <material name="block_red"    rgba="0.85 0.18 0.12 1"/>
    <material name="block_green"  rgba="0.15 0.75 0.25 1"/>
    <material name="block_blue"   rgba="0.15 0.35 0.85 1"/>
    <material name="target_mat"   rgba="1.0 0.9 0.2 0.35"/>
    <material name="arm_yellow"   rgba="1 0.82 0.12 1"/>
    <material name="arm_dark"     rgba="0.1 0.1 0.1 1"/>
    <!-- All meshes shared between both arms (geometry is identical) -->
    <mesh file="base_motor_holder_so101_v1.stl"/>
    <mesh file="base_so101_v2.stl"/>
    <mesh file="sts3215_03a_v1.stl"/>
    <mesh file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="motor_holder_so101_base_v1.stl"/>
