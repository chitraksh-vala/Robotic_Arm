      <geom type="sphere" size="0.013" rgba="0.2 0.6 1.0 0.8" contype="0" conaffinity="0"/>
    </body>
    <body name="R_ik_target" pos="0.22 -0.10 0.15">
      <joint name="R_tgt_x" type="slide" axis="1 0 0" range="-0.5 0.5" damping="100"/>
      <joint name="R_tgt_y" type="slide" axis="0 1 0" range="-0.5 0.5" damping="100"/>
